# ========== 模型配置（问答功能必需，复制本文件为 .env 后填写） ==========
# OpenAI 协议兼容地址（不带 /v1）：官方 https://api.openai.com 或任意中转站地址
OPENAI_BASE_URL=https://api.openai.com
# 你的模型 API Key（敏感信息，切勿提交到仓库）
OPENAI_API_KEY=sk-your-key-here
# 模型名（示例：deepseek/deepseek-chat、gpt-4o、kimi-k3 等）
OPENAI_MODEL=deepseek/deepseek-chat

# ========== 前端对外端口 ==========
# Docker 前端唯一对外端口（默认 8080；如端口被占用可改为 18080 等）
FRONTEND_PORT=8080
